@model MiniB2B.Web.Models.User
@{
    ViewData["Title"] = "Yeni Bayi Başvurusu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-11 col-sm-10 col-md-7 col-lg-6">
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <div class="bg-dark text-white p-4 text-center">
                    <h4 class="fw-bold mb-1">🏢 Mini B2B Portal</h4>
                    <small class="text-white-50">Yeni Bayi Başvuru ve Kayıt Formu</small>
                </div>

                <div class="p-4 p-md-5">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger py-2 small shadow-sm mb-4">
                            ⚠️ @ViewBag.Error
                        </div>
                    }

                    <form method="post" asp-action="Register" id="registerForm">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small text-secondary">Ad *</label>
                                <input type="text" name="FirstName" class="form-control" placeholder="Örn: Ahmet" value="@(Model?.FirstName)" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small text-secondary">Soyad *</label>
                                <input type="text" name="LastName" class="form-control" placeholder="Örn: Yılmaz" value="@(Model?.LastName)" required />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold small text-secondary">Kullanıcı Adı *</label>
                                <input type="text" name="Username" class="form-control" placeholder="Örn: yilmazticaret" value="@(Model?.Username)" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold small text-secondary">E-posta Adresi *</label>
                                <input type="email" name="Email" class="form-control" placeholder="info@firma.com" value="@(Model?.Email)" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small text-secondary">Telefon Numarası</label>
                                <input type="tel" name="PhoneNumber" class="form-control" placeholder="0555 123 4567" value="@(Model?.PhoneNumber)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold small text-secondary">Giriş Şifresi *</label>
                                <div class="input-group">
                                    <input type="password" id="passwordInput" name="Password" class="form-control border-end-0" placeholder="En az 6 karakter" required minlength="6" />
                                    <button type="button" class="btn btn-outline-secondary bg-white border-start-0 text-muted" onclick="togglePassword('passwordInput', this)" style="border-color: #ced4da;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold small text-secondary">Şifre Tekrarı *</label>
                                <div class="input-group">
                                    <input type="password" id="confirmPasswordInput" name="ConfirmPassword" class="form-control border-end-0" placeholder="Şifrenizi tekrar girin" required minlength="6" />
                                    <button type="button" class="btn btn-outline-secondary bg-white border-start-0 text-muted" onclick="togglePassword('confirmPasswordInput', this)" style="border-color: #ced4da;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <div class="col-12">
                                <div id="passwordMismatchAlert" class="alert alert-warning py-1 px-2 small mb-0 d-none">
                                    ⚠️ Girdiğiniz şifreler birbiriyle uyuşmuyor!
                                </div>
                                <div id="passwordMatchAlert" class="alert alert-success py-1 px-2 small mb-0 d-none">
                                    ✅ Şifreler eşleşti.
                                </div>
                            </div>

                            <div class="col-12 mt-4">
                                <button type="submit" id="submitBtn" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm">
                                    📝 Bayi Olarak Kayıt Ol
                                </button>
                            </div>
                        </div>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <small class="text-muted">Zaten bir bayi hesabınız var mı?</small>
                        <div>
                            <a href="/Account/Login" class="fw-bold text-decoration-none small text-primary">
                                Giriş Ekranına Dön 🔑
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const eyeOpen = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
        </svg>`;

        const eyeClosed = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-eye-slash" viewBox="0 0 16 16">
            <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755q-.247.248-.517.486z"/>
            <path d="M11.297 9.124a3.5 3.5 0 0 0-4.42-4.42l1.409 1.408a2.5 2.5 0 0 1 3.011 3.012l1.001 1.002z"/>
            <path d="M4.195 4.195A8 8 0 0 0 0 8s3 5.5 8 5.5a7 7 0 0 0 4.205-1.411l-1.16-1.16A6 6 0 0 1 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8q.086-.13.195-.288c.335-.48.83-1.12 1.465-1.755q.247-.248.517-.486l-1.02-1.02-1.16-1.16z"/>
            <path d="M13.646 14.354l-12-12 .708-.708 12 12z"/>
        </svg>`;

        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text';
                btn.innerHTML = eyeClosed;
            } else {
                input.type = 'password';
                btn.innerHTML = eyeOpen;
            }
        }

        const pass = document.getElementById('passwordInput');
        const confirmPass = document.getElementById('confirmPasswordInput');
        const mismatch = document.getElementById('passwordMismatchAlert');
        const match = document.getElementById('passwordMatchAlert');
        const submitBtn = document.getElementById('submitBtn');

        function checkPasswords() {
            if (!confirmPass.value) {
                mismatch.classList.add('d-none');
                match.classList.add('d-none');
                submitBtn.disabled = false;
                return;
            }

            if (pass.value !== confirmPass.value) {
                mismatch.classList.remove('d-none');
                match.classList.add('d-none');
                submitBtn.disabled = true;
            } else {
                mismatch.classList.add('d-none');
                match.classList.remove('d-none');
                submitBtn.disabled = false;
            }
        }

        pass.addEventListener('input', checkPasswords);
        confirmPass.addEventListener('input', checkPasswords);
    </script>
}