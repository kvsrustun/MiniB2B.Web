@{
    ViewData["Title"] = "Erişim Reddedildi";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-5 rounded-4">
                <div class="display-1 text-danger mb-3">🚫</div>
                <h2 class="fw-bold text-danger">Yetkisiz Erişim!</h2>
                <p class="text-muted fs-5 mt-2">
                    Bu sayfayı (Yönetim Paneli) görüntülemek için <strong>Admin</strong> yetkisine sahip olmanız gerekmektedir.
                </p>
                <div class="alert alert-warning py-2 small mb-4">
                    Şu anki rolünüz: <strong>@Context.Session.GetString("Role")</strong>
                </div>
                <div class="d-flex justify-content-center gap-2">
                    <a href="/" class="btn btn-primary px-4 py-2">🛍️ Ürün Kataloğuna Git</a>
                    <a href="/Account/Logout" class="btn btn-outline-danger px-4 py-2">Farklı Hesapla Giriş Yap</a>
                </div>
            </div>
        </div>
    </div>
</div>