@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiniB2B Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MiniB2B.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">🏢 Mini B2B</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- Sol Menü: Kullanıcının Rolüne Göre Gösterilir -->
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold" asp-controller="Home" asp-action="Index">🛍️ Ürün Kataloğu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold" asp-controller="Cart" asp-action="Index">🛒 Sepetim</a>
                        </li>

                        @if (Context.Session.GetString("Role") == "Admin")
                        {
                            <!-- SADECE ADMİN GÖRÜR -->
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold" asp-controller="Admin" asp-action="Index">⚙️ Yönetim Paneli</a>
                            </li>
                        }
                        else if (Context.Session.GetString("Role") == "Dealer")
                        {
                            <!-- SADECE BAYİ GÖRÜR -->
                            <li class="nav-item">
                                <a class="nav-link text-success fw-bold" asp-controller="Cart" asp-action="MyOrders">📦 Geçmiş Siparişlerim</a>
                            </li>
                        }
                    </ul>

                    <!-- Sağ Menü: Giriş / Çıkış ve Kullanıcı Bilgisi -->
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (Context.Session.GetString("Username") != null)
                        {
                            <li class="nav-item me-3">
                                <span class="badge bg-light text-dark border p-2">
                                    👤 @Context.Session.GetString("FullName") 
                                    <span class="badge @(Context.Session.GetString("Role") == "Admin" ? "bg-danger" : "bg-success") ms-1">
                                        @Context.Session.GetString("Role")
                                    </span>
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm" asp-controller="Account" asp-action="Logout">Çıkış Yap 🚪</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Login">Giriş Yap 🔑</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3">
        <div class="container text-center">
            &copy; 2026 - Mini B2B Sipariş ve Bayi Yönetim Portalı
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>