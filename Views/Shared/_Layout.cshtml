@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiniB2B Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        :root {
            --bs-primary: #1e3a8a;          
            --bs-primary-rgb: 30, 58, 138;
            --bs-primary-hover: #172554;
        }

        .btn-primary {
            background-color: var(--bs-primary) !important;
            border-color: var(--bs-primary) !important;
        }
        .btn-primary:hover, .btn-primary:focus {
            background-color: var(--bs-primary-hover) !important;
            border-color: var(--bs-primary-hover) !important;
        }
        .text-primary {
            color: var(--bs-primary) !important;
        }

        .nav-link {
            color: #1e293b !important;
            font-weight: 500;
        }
        .nav-link:hover {
            color: var(--bs-primary) !important;
        }

        body {
            background-color: #f8fafc;
            color: #0f172a;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="border-bottom bg-white shadow-xs sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light py-2">
            <div class="container-fluid px-4" style="max-width: 1400px;">
                <a class="navbar-brand fw-bold text-dark d-flex align-items-center gap-2" href="/">
                    🏢 Mini B2B
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-2 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" href="/">🛍️ Ürün Kataloğu</a>
                        </li>

                        @{
                            int cartCount = Context.Session.GetInt32("CartCount") ?? 0;
                        }
                        <li class="nav-item">
                            <a class="nav-link position-relative d-inline-flex align-items-center" href="/Cart">
                                🛒 Sepetim
                                <span id="cartBadge" 
                                      class="badge rounded-pill bg-danger ms-1 @(cartCount == 0 ? "d-none" : "")"
                                      style="font-size: 0.72rem; padding: 0.25em 0.6em;">
                                    @cartCount
                                </span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Cart/MyOrders">📋 Sipariş Geçmişim</a>                        </li>
                        
                        @if (Context.Session.GetString("Role") == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Admin">⚙️ Yönetim Paneli</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (Context.Session.GetString("UserId") != null)
                        {
                            <li class="nav-item d-flex align-items-center gap-2 border-end pe-3 me-2">
                                <span class="small text-secondary">👤 @Context.Session.GetString("FullName")</span>
                                @if (Context.Session.GetString("Role") == "Admin")
                                {
                                    <span class="badge bg-dark">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Bayi</span>
                                }
                            </li>
                            <li class="nav-item">
                                <a href="/Account/Logout" class="btn btn-sm btn-outline-danger px-3">Çıkış Yap 🚪</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a href="/Account/Login" class="btn btn-sm btn-primary px-3 fw-semibold">Giriş Yap 🔑</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="border-top py-3 bg-white text-center text-secondary small mt-auto">
        <div class="container">
            &copy; 2026 - Mini B2B Sipariş ve Bayi Yönetim Portalı
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function updateCartBadge(count) {
            const badge = document.getElementById('cartBadge');
            if (badge) {
                badge.innerText = count;
                if (count > 0) {
                    badge.classList.remove('d-none');
                } else {
                    badge.classList.add('d-none');
                }
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            fetch('/Cart/GetCartCount')
                .then(res => res.json())
                .then(data => {
                    if (data && typeof data.count !== 'undefined') {
                        updateCartBadge(data.count);
                    }
                })
                .catch(() => {});
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>