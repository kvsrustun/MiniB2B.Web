@model MiniB2B.Web.Models.Product
@{
    ViewData["Title"] = "Yeni Ürün Ekle";
    var categories = ViewBag.Categories as List<MiniB2B.Web.Models.Category> ?? new List<MiniB2B.Web.Models.Category>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold mb-0">➕ Yeni Ürün Ekle</h3>
                <a href="/Admin/Products" class="btn btn-outline-secondary">← Listeye Dön</a>
            </div>

            <div class="card border bg-white shadow-xs p-4 rounded-3">
                <form method="post" asp-action="CreateProduct">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Ürün Kodu *</label>
                            <input type="text" name="ProductCode" class="form-control" placeholder="Örn: PRD-1005" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Marka *</label>
                            <input type="text" name="Brand" class="form-control" placeholder="Örn: Bosch, SKF, Siemens" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small text-secondary">Ürün Adı *</label>
                            <input type="text" name="Name" class="form-control" placeholder="Örn: 6205 Derin Oluklu Bilyalı Rulman" required />
                        </div>

                        <!-- 🎯 ŞARTNAME SAYFA 1: AÇIKLAMA -->
                        <div class="col-12">
                            <label class="form-label fw-semibold small text-secondary">Ürün Açıklaması</label>
                            <textarea name="Description" class="form-control" rows="2" placeholder="Ürün detaylı teknik özellikleri..."></textarea>
                        </div>

                        <!-- 🎯 ŞARTNAME SAYFA 1: ÜRETİCİ KODU VE ÖZEL KODLAR -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-secondary">Üretici Kodu</label>
                            <input type="text" name="ManufacturerCode" class="form-control" placeholder="Örn: MFG-9821" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-secondary">Özel Kod 1</label>
                            <input type="text" name="SpecialCode1" class="form-control" placeholder="Örn: OZEL-A" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-secondary">Özel Kod 2</label>
                            <input type="text" name="SpecialCode2" class="form-control" placeholder="Örn: OZEL-B" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Kategori *</label>
                            <select name="CategoryId" class="form-select" required>
                                <option value="">-- Kategori Seçiniz --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Birim Fiyat (₺) *</label>
                            <input type="number" step="0.01" name="Price" class="form-control" placeholder="0.00" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Stok Miktarı *</label>
                            <input type="number" name="StockQuantity" class="form-control" value="10" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Kritik Stok Eşiği *</label>
                            <input type="number" name="CriticalStockThreshold" class="form-control" value="3" min="1" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small text-secondary">Görsel URL</label>
                            <input type="text" name="ImageUrl" class="form-control" placeholder="https://..." />
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-success btn-lg w-100 fw-bold shadow-xs">
                                🚀 Ürünü Kaydet
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>