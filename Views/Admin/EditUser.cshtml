@model MiniB2B.Web.Models.User
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0">✏️ Kullanıcı Düzenle: @Model.Username</h2>
                <a href="/Admin/Users" class="btn btn-outline-secondary">← Listeye Dön</a>
            </div>

            <div class="card border-0 shadow-sm p-4 rounded-3">
                <form method="post" asp-action="EditUser">
                    <input type="hidden" name="Id" value="@Model.Id" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Ad</label>
                            <input type="text" name="FirstName" value="@Model.FirstName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Soyad</label>
                            <input type="text" name="LastName" value="@Model.LastName" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">E-posta</label>
                            <input type="email" name="Email" value="@Model.Email" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Telefon</label>
                            <input type="text" name="PhoneNumber" value="@Model.PhoneNumber" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Sistem Rolü</label>
                            <select name="Role" class="form-select">
                                <option value="Dealer" selected="@(Model.Role == "Dealer")">Dealer (Bayi)</option>
                                <option value="Admin" selected="@(Model.Role == "Admin")">Admin (Yönetici)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Hesap Durumu</label>
                            <select name="IsActive" class="form-select">
                                <option value="true" selected="@Model.IsActive">Aktif</option>
                                <option value="false" selected="@(!Model.IsActive)">Pasif (Giriş Engellensin)</option>
                            </select>
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">
                                Bilgileri Kaydet
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>