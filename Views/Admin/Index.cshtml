@model IEnumerable<MiniB2B.Web.Models.Product>
@{
    ViewData["Title"] = "Yönetim Paneli";
}

<div class="container-fluid py-4 px-4" style="max-width: 1400px;">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 pb-3 mb-4 border-bottom">
        <div>
            <h3 class="fw-bold text-dark mb-1">Yönetim Paneli</h3>
            <p class="text-secondary mb-0 small">Katalog, stok durumları, sipariş onayları ve sistem yapılandırması.</p>
        </div>
        <a href="/" class="btn btn-primary fw-semibold px-3 py-2 shadow-sm rounded-3">
            🛍️ Bayi Görünümüne Dön
        </a>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="/Admin/Products" class="btn btn-white border bg-white text-dark fw-medium px-3 py-2 shadow-xs rounded-3 hover-shadow">
            📦 Ürün Yönetimi
        </a>
        <a href="/Admin/Users" class="btn btn-white border bg-white text-dark fw-medium px-3 py-2 shadow-xs rounded-3 hover-shadow">
            👥 Kullanıcı Yönetimi
        </a>
        <a href="/Admin/Banners" class="btn btn-white border bg-white text-dark fw-medium px-3 py-2 shadow-xs rounded-3 hover-shadow">
            📢 İlan & Slider Yönetimi
        </a>
        <a href="/Admin/Columns" class="btn btn-white border bg-white text-dark fw-medium px-3 py-2 shadow-xs rounded-3 hover-shadow">
            🎛️ Kolon Ayarları
        </a>
        <a href="/Admin/Orders" class="btn btn-white border bg-white text-dark fw-medium px-3 py-2 shadow-xs rounded-3 hover-shadow">
            📋 Tüm Siparişler
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 bg-success bg-opacity-10 text-success py-2 px-3 small rounded-3 mb-4">
            ✅ @TempData["Success"]
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="stat-card p-3 h-100 rounded-3 border">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.75rem;">Toplam Ürün</span>
                        <h3 class="fw-bold text-dark mt-2 mb-0">@ViewBag.TotalProducts</h3>
                    </div>
                    <span class="stat-icon bg-white shadow-xs rounded-3 p-2">📦</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="stat-card p-3 h-100 rounded-3 border">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.75rem;">Kritik / Biten Stok</span>
                        <h3 class="fw-bold text-danger mt-2 mb-0">@ViewBag.CriticalCount</h3>
                    </div>
                    <span class="stat-icon bg-white shadow-xs rounded-3 p-2">⚠️</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="stat-card p-3 h-100 rounded-3 border">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.75rem;">Toplam Sipariş</span>
                        <h3 class="fw-bold text-dark mt-2 mb-0">@ViewBag.TotalOrders</h3>
                    </div>
                    <span class="stat-icon bg-white shadow-xs rounded-3 p-2">🛒</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="stat-card p-3 h-100 rounded-3 border">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.75rem;">Toplam Sipariş Tutarı</span>
                        <h3 class="fw-bold text-dark mt-2 mb-0">@ViewBag.TotalRevenue.ToString("N2") ₺</h3>
                    </div>
                    <span class="stat-icon bg-white shadow-xs rounded-3 p-2">💳</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card border bg-white shadow-xs rounded-3 overflow-hidden">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
            <div>
                <h6 class="fw-bold text-dark mb-0">⚠️ Kritik Seviyedeki ve Tükenen Ürünler</h6>
                <small class="text-secondary">Stoku kritik eşiğin altına düşen ürünleri buradan anında güncelleyebilirsiniz.</small>
            </div>
            <span class="badge bg-light text-secondary border">@Model.Count() Ürün Listeleniyor</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small">
                    <tr>
                        <th style="width: 70px;">Görsel</th>
                        <th>Ürün Kodu</th>
                        <th>Ürün Adı</th>
                        <th>Kategori</th>
                        <th>Mevcut Stok</th>
                        <th>Kritik Eşik</th>
                        <th style="width: 220px;">Hızlı Stok Güncelle</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-success">
                                ✨ Harika! Kritik stok seviyesinde veya tükenmiş hiçbir ürün bulunmuyor.
                            </td>
                        </tr>
                    }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "https://via.placeholder.com/50" : p.ImageUrl)" 
                                     alt="@p.Name" 
                                     class="rounded border bg-light" 
                                     style="width: 44px; height: 44px; object-fit: cover;" />
                            </td>
                            <td><span class="badge bg-light text-dark border font-monospace">@p.ProductCode</span></td>
                            <td class="fw-semibold text-dark">@p.Name</td>
                            <td class="text-secondary">@(p.Category?.Name ?? "-")</td>
                            <td>
                                @if (p.StockQuantity == 0)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">0 Adet (Tükendi)</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning border-opacity-25 px-2 py-1">@p.StockQuantity Adet</span>
                                }
                            </td>
                            <td>
                                <span class="text-secondary small">@p.CriticalStockThreshold Adet</span>
                            </td>
                            <td>
                                <form method="post" asp-action="UpdateStock" class="d-flex gap-1 align-items-center">
                                    <input type="hidden" name="productId" value="@p.Id" />
                                    <input type="number" name="newStock" value="@p.StockQuantity" min="0" class="form-control form-control-sm text-center" style="width: 70px;" title="Yeni Stok" />
                                    <input type="number" name="newThreshold" value="@p.CriticalStockThreshold" min="1" class="form-control form-control-sm text-center" style="width: 65px;" title="Yeni Kritik Eşik" />
                                    <button type="submit" class="btn btn-sm btn-dark px-2">Kaydet</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .stat-card {
        background-color: #f1f5f9 !important; 
        border-color: #e2e8f0 !important;
        transition: all 0.2s ease-in-out;
    }
    
    .stat-card:hover {
        background-color: #e2e8f0 !important;
        transform: translateY(-2px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.06);
    }

    .stat-icon {
        font-size: 1.2rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border: 1px solid #e2e8f0;
    }

    .shadow-xs {
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    }

    .hover-shadow:hover {
        background-color: #f8f9fa !important;
        border-color: #cbd5e1 !important;
    }
</style>