@model IEnumerable<MiniB2B.Web.Models.Product>
@{
    ViewData["Title"] = "Yönetim Paneli - Dashboard";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">⚙️ Yönetim Paneli (Admin)</h2>
            <p class="text-muted mb-0">Sistem durumu, kritik stok uyarıları ve hızlı yönetim.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Admin/Columns" class="btn btn-outline-dark">🎛️ Grid Kolon Ayarları</a>
            <a href="/Admin/Orders" class="btn btn-outline-primary">📋 Tüm Siparişler</a>
            <a href="/" class="btn btn-primary">🛍️ Bayi Arayüzüne Dön</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm mb-4">
            ✅ @TempData["Success"]
        </div>
    }

    <!-- İstatistik Kartları -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white p-3">
                <div class="text-white-50 small">Toplam Ürün Çeşidi</div>
                <div class="fs-2 fw-bold">@ViewBag.TotalProducts</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-danger text-white p-3">
                <div class="text-white-50 small">⚠️ Kritik/Biten Stok</div>
                <div class="fs-2 fw-bold">@ViewBag.CriticalCount</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white p-3">
                <div class="text-white-50 small">Toplam Alınan Sipariş</div>
                <div class="fs-2 fw-bold">@ViewBag.TotalOrders</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-dark text-white p-3">
                <div class="text-white-50 small">Toplam Sipariş Tutarı</div>
                <div class="fs-2 fw-bold">@(((decimal)ViewBag.TotalRevenue).ToString("N2")) ₺</div>
            </div>
        </div>
    </div>

    <!-- Kritik Stok Uyarı Tablosu (Ödev İsteri) -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-warning bg-opacity-10 border-0 py-3">
            <h5 class="fw-bold mb-0 text-dark">⚠️ Kritik Stok Seviyesindeki veya Tükenen Ürünler</h5>
            <small class="text-muted">Bu ürünlerin stoku belirlenen kritik eşiğin altına inmiştir. Buradan doğrudan güncelleyebilirsiniz.</small>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Görsel</th>
                        <th>Ürün Kodu</th>
                        <th>Ürün Adı</th>
                        <th>Kategori</th>
                        <th>Mevcut Stok</th>
                        <th>Kritik Eşik</th>
                        <th style="width: 280px;">Hızlı Stok Güncelle</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-success fw-bold">
                                🎉 Harika! Kritik seviyede hiçbir ürün bulunmuyor.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/50" : item.ImageUrl)" style="width: 45px; height: 45px; object-fit: cover; border-radius: 6px;" />
                            </td>
                            <td><span class="badge bg-secondary font-monospace">@item.ProductCode</span></td>
                            <td class="fw-semibold">@item.Name</td>
                            <td>@(item.Category?.Name ?? "-")</td>
                            <td>
                                @if (item.StockQuantity == 0)
                                {
                                    <span class="badge bg-danger">TÜKENDİ (0)</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@item.StockQuantity Adet</span>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@item.CriticalStockThreshold Adet</span></td>
                            <td>
                                <form asp-action="UpdateStock" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="productId" value="@item.Id" />
                                    <input type="number" name="newStock" value="@item.StockQuantity" min="0" class="form-control form-control-sm" style="width: 80px;" title="Yeni Stok" />
                                    <input type="number" name="newThreshold" value="@item.CriticalStockThreshold" min="1" class="form-control form-control-sm" style="width: 70px;" title="Kritik Eşik" />
                                    <button type="submit" class="btn btn-sm btn-primary">Kaydet</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>