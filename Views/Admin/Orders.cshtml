@model IEnumerable<MiniB2B.Web.Models.Order>
@{
    ViewData["Title"] = "Tüm Siparişler - Yönetim";
}

<div class="container-fluid py-4 px-4" style="max-width: 1400px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">📋 Sipariş Yönetimi (B2B)</h3>
            <p class="text-secondary mb-0 small">Bayiler tarafından oluşturulan tüm siparişler, müşteri detayları ve onay süreçleri.</p>
        </div>
        <a href="/Admin" class="btn btn-outline-secondary px-3">← Panele Dön</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 bg-success bg-opacity-10 text-success py-2 px-3 small rounded-3 mb-4">
            ✅ @TempData["Success"]
        </div>
    }

    <div class="card border bg-white shadow-xs rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-dark text-white small">
                    <tr>
                        <th style="width: 180px;">Sipariş No</th>
                        <th>Siparişi Veren Bayi (Müşteri)</th>
                        <th>İletişim (E-Posta / Tel)</th>
                        <th>Tarih</th>
                        <th>Toplam Tutar</th>
                        <th class="text-center">Durum</th>
                        <th class="text-end" style="width: 220px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Henüz hiçbir sipariş verilmemiş.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary font-monospace">@item.OrderNumber</td>
                            <td>
                                @if (item.User != null)
                                {
                                    <div class="fw-bold text-dark">@item.User.FirstName @item.User.LastName</div>
                                    <span class="badge bg-light text-secondary border font-monospace">Kullanıcı: @item.User.Username</span>
                                }
                                else
                                {
                                    <div class="fw-bold text-muted">Bilinmeyen Kullanıcı</div>
                                }
                            </td>
                            <td>
                                @if (item.User != null)
                                {
                                    <div class="small text-muted mb-1">✉️ @item.User.Email</div>
                                    <div class="small text-muted">📞 @(string.IsNullOrEmpty(item.User.PhoneNumber) ? "-" : item.User.PhoneNumber)</div>
                                }
                            </td>
                            <td>@item.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="fw-bold text-success fs-6">@item.TotalAmount.ToString("N2") ₺</td>
                            <td class="text-center">
                                @if (item.Status == "Onaylandı")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">✅ Onaylandı</span>
                                }
                                else if (item.Status == "Reddedildi")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">❌ Reddedildi</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning border-opacity-25 px-2 py-1">⏳ @item.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1 justify-content-end">
                                    <!-- 🎯 ŞARTNAME SAYFA 2: SİPARİŞ DETAYINI GÖRME BUTONU -->
                                    <button type="button" class="btn btn-sm btn-outline-primary px-2" style="height: 32px;" onclick="showOrderItemsModal('@item.OrderNumber', '@(item.User?.FirstName + " " + item.User?.LastName)', '@item.TotalAmount.ToString("N2")', '@item.Id')">
                                        Detay
                                    </button>

                                    @if (item.Status != "Onaylandı")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success px-2 py-1" style="height: 32px;" onclick="openOrderActionModal('@item.Id', '@item.OrderNumber', 'Onaylandı')">
                                            Onayla
                                        </button>
                                    }

                                    @if (item.Status != "Reddedildi")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger px-2 py-1" style="height: 32px;" onclick="openOrderActionModal('@item.Id', '@item.OrderNumber', 'Reddedildi')">
                                            Reddet
                                        </button>
                                    }
                                </div>

                                <!-- Gizli Kalemler Verisi (JavaScript ile okumak için) -->
                                <div id="items_data_@item.Id" class="d-none">
                                    @foreach (var oi in item.Items)
                                    {
                                        <div data-name="@oi.ProductNameSnapshot" data-code="@oi.ProductCodeSnapshot" data-qty="@oi.Quantity" data-unitprice="@oi.UnitPriceSnapshot.ToString("N2")" data-totalprice="@oi.TotalPrice.ToString("N2")"></div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 🎯 ŞARTNAME MADDE 3: SİPARİŞ DETAY VE KALEMLERİ MODALI -->
<div class="modal fade" id="orderItemsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header bg-light border-bottom">
                <div>
                    <h5 class="modal-title fw-bold text-dark mb-0">Sipariş Detayı</h5>
                    <small class="text-secondary" id="detailOrderSubtitle"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0">
                        <thead class="bg-light small">
                            <tr>
                                <th>Ürün Kodu</th>
                                <th>Ürün Adı</th>
                                <th class="text-center">Adet</th>
                                <th class="text-end">Birim Fiyat (Snapshot)</th>
                                <th class="text-end">Toplam Fiyat</th>
                            </tr>
                        </thead>
                        <tbody id="modalItemsTableBody">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light border-top justify-content-between">
                <div>
                    <span class="text-secondary small">Genel Toplam: </span>
                    <span class="fs-5 fw-bold text-success" id="detailOrderTotal"></span>
                </div>
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- Modern Onay/Reddet Modalı (Evet / Hayır) -->
<div class="modal fade" id="orderActionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-body p-4 text-center">
                <div id="modalIcon" class="mb-3" style="font-size: 3rem;"></div>
                <h5 id="modalTitle" class="fw-bold text-dark mb-2"></h5>
                <p class="text-secondary small mb-4">
                    <span id="modalOrderNumber" class="fw-bold text-dark font-monospace"></span> numaralı siparişi <span id="modalActionText" class="fw-semibold"></span> istediğinizden emin misiniz?
                </p>

                <form id="orderActionForm" method="post" action="/Admin/UpdateOrderStatus">
                    <input type="hidden" id="modalOrderId" name="orderId" value="" />
                    <input type="hidden" id="modalStatus" name="status" value="" />

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light w-50 fw-semibold border" data-bs-dismiss="modal">Hayır</button>
                        <button type="submit" id="modalSubmitBtn" class="btn w-50 fw-bold">Evet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showOrderItemsModal(orderNumber, customerName, totalAmount, orderId) {
            document.getElementById('detailOrderSubtitle').innerText = `Sipariş No: ${orderNumber} | Müşteri: ${customerName}`;
            document.getElementById('detailOrderTotal').innerText = totalAmount + ' ₺';

            const container = document.getElementById('items_data_' + orderId);
            const tbody = document.getElementById('modalItemsTableBody');
            tbody.innerHTML = '';

            if (container) {
                const items = container.querySelectorAll('div');
                if (items.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">Bu siparişe ait ürün bulunamadı.</td></tr>';
                }
                items.forEach(div => {
                    const row = `<tr>
                        <td><span class="badge bg-light text-dark border font-monospace">${div.dataset.code}</span></td>
                        <td class="fw-semibold">${div.dataset.name}</td>
                        <td class="text-center fw-bold">${div.dataset.qty} Adet</td>
                        <td class="text-end">${div.dataset.unitprice} ₺</td>
                        <td class="text-end fw-bold text-success">${div.dataset.totalprice} ₺</td>
                    </tr>`;
                    tbody.innerHTML += row;
                });
            }

            const modal = new bootstrap.Modal(document.getElementById('orderItemsModal'));
            modal.show();
        }

        function openOrderActionModal(orderId, orderNumber, status) {
            document.getElementById('modalOrderId').value = orderId;
            document.getElementById('modalStatus').value = status;
            document.getElementById('modalOrderNumber').innerText = orderNumber;

            const icon = document.getElementById('modalIcon');
            const title = document.getElementById('modalTitle');
            const actionText = document.getElementById('modalActionText');
            const submitBtn = document.getElementById('modalSubmitBtn');

            if (status === 'Onaylandı') {
                icon.innerHTML = '✅';
                title.innerText = 'Siparişi Onayla';
                actionText.innerText = 'onaylamak';
                submitBtn.className = 'btn btn-success w-50 fw-bold shadow-xs';
            } else {
                icon.innerHTML = '⚠️';
                title.innerText = 'Siparişi Reddet';
                actionText.innerText = 'reddetmek';
                submitBtn.className = 'btn btn-danger w-50 fw-bold shadow-xs';
            }

            const modal = new bootstrap.Modal(document.getElementById('orderActionModal'));
            modal.show();
        }
    </script>
}